{
  "name": "neuron",
  "version": "0.4.5",
  "description": "Local-first Markdown and MDX knowledge workspace",
  "author": "Shivam Khetan <shivkhetan18@gmail.com>",
  "license": "Apache-2.0",
  "private": false,
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "clean:build": "node tools/clean-build.mjs",
    "dev:renderer": "vite",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "dev": "concurrently -k -n \"renderer,main,electron\" -c \"blue,yellow,green\" \"npm run dev:renderer\" \"npm run dev:main\" \"node tools/dev/start-electron.js\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node tools/copy-htmx.mjs",
    "build": "npm run clean:build && npm run build:main && npm run build:renderer",
    "postinstall": "node tools/fix-pty-permissions.mjs",
    "dist": "npm run dist:test",
    "dist:test": "node tools/package-env.mjs test",
    "dist:dir": "node tools/package-env.mjs test --dir",
    "dist:store": "node tools/package-env.mjs prod --store",
    "release": "node tools/package-env.mjs prod --publish",
    "icon:svg": "node tools/icons/icon-source.mjs",
    "icon:generate": "node tools/icons/generate-app-icon.js",
    "test:views": "node tools/view-security.test.mjs",
    "test:frontmatter": "node tools/frontmatter.test.mjs",
    "test:htmx": "node tools/htmx-views.test.mjs",
    "test:canvas": "node tools/canvas-model.test.mjs",
    "test:sanitize": "node tools/sanitize-html.test.mjs",
    "test:navigation": "node tools/navigation.test.mjs",
    "test:journal": "node tools/journal.test.mjs",
    "test:db": "node tools/db.test.mjs",
    "test:templates": "npm run build:main && node tools/templates.test.mjs",
    "test:contrast": "node tools/contrast.test.mjs",
    "test:terminal-bus": "node tools/terminal-bus.test.mjs",
    "test:terminal-history": "node tools/terminal-history.test.mjs",
    "test:diagnostics": "node tools/diagnostic-logger.test.mjs",
    "test:crash": "node tools/crash-reporter.test.mjs",
    "test:demo-data": "node tools/demo-data.test.mjs",
    "test:e2e": "npm run build:main && playwright test",
    "test": "npm run test:deps && npm run test:views && npm run test:frontmatter && npm run test:htmx && npm run test:canvas && npm run test:sanitize && npm run test:navigation && npm run test:journal && npm run test:db && npm run test:templates && npm run test:contrast && npm run test:terminal-bus && npm run test:terminal-history && npm run test:diagnostics && npm run test:crash && npm run test:demo-data && npm run test:procs && npm run test:prune && npm run test:chrome && npm run test:appx-assets && npm run test:icon-source && npm run test:wikilinks && npm run test:search && npm run test:explorer && npm run test:assistant-context && npm run test:mermaid && npm run test:updater && npm run test:manifests && npm run test:windows-installer && npm run test:publish-gate && npm run test:graph",
    "shoot": "node tools/shoot.mjs",
    "test:procs": "node tools/procs.test.mjs",
    "test:prune": "node tools/prune-releases.test.mjs",
    "test:chrome": "node tools/platform-chrome.test.mjs",
    "test:appx-assets": "node tools/appx-assets.test.mjs",
    "test:icon-source": "node tools/icon-source.test.mjs",
    "test:wikilinks": "node tools/wikilinks.test.mjs",
    "test:search": "node tools/search.test.mjs",
    "test:explorer": "node tools/workspace-explorer.test.mjs",
    "test:assistant-context": "node tools/assistant-context.test.mjs",
    "test:mermaid": "node tools/mermaid.test.mjs",
    "test:updater": "node tools/updater.test.mjs",
    "test:manifests": "node tools/release-manifests.test.mjs",
    "test:windows-installer": "node tools/windows-installer.test.mjs",
    "test:publish-gate": "node tools/publish-gate.test.mjs",
    "verify:appx": "node tools/verify-appx.mjs",
    "store:shots": "node tools/store-shots.mjs",
    "store:logos": "node tools/store-logos.mjs",
    "smoke": "node tools/smoke-packaged.mjs",
    "test:deps": "node tools/deps.test.mjs",
    "test:graph": "node tools/knowledge-graph.test.mjs",
    "bench:graph": "node tools/graph-benchmark.mjs",
    "bench:graph:browser": "node tools/graph-benchmark-run.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language-data": "^6.3.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.0",
    "@mdx-js/mdx": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-aspect-ratio": "^1.1.10",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-direction": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-menubar": "^1.1.18",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.22.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.77",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "htmx.org": "^2.0.10",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.395.0",
    "mermaid": "^11.17.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "linkedom": "^0.18.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.2"
  },
  "build": {
    "appId": "io.github.neuron.notes",
    "productName": "Neuron",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable",
        "appx"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "applicationId": "Neuron",
      "displayName": "Neuron Desktop",
      "identityName": "ShivamKhetan.NeuronDesktop",
      "publisher": "CN=7632F1A5-D41D-4A68-802B-CBBC1A910C2A",
      "publisherDisplayName": "Shivam Khetan",
      "backgroundColor": "#000000",
      "languages": [
        "en-US"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
